gB,CAAA;AAAA;;gBAE7NA,YAAwC,QAAA,EAAlC,OAAM,gBAAe,GAAC,OAAK;AAAA,gBACjCA,YAA8D,QAAA,EAAxD,OAAM,gBAAe,GAAC,6BAA2B;AAAA;cAEzDA,YAMI,KAAA;AAAA,gBAND,OAAM;AAAA,gBAAe,MAAK;AAAA;gBAC3BA,YAEO,QAAA;AAAA,kBAFD,OAAM;AAAA,kBAAe,eAAY;AAAA;gCACrCC,YAAic,OAAA;AAAA,oBAA5b,OAAM;AAAA,oBAAK,QAAO;AAAA,oBAAK,SAAQ;AAAA,oBAAY,MAAK;AAAA,oBAAO,QAAO;AAAA,oBAAe,gBAAa;AAAA,oBAAI,kBAAe;AAAA,oBAAQ,mBAAgB;AAAA;oBAAQD,YAAyS,QAAA,EAAnS,GAAE,gSAA+R,CAAA;AAAA;;gBAE3bA,YAAwC,QAAA,EAAlC,OAAM,gBAAe,GAAC,OAAK;AAAA,gBACjCA,YAAgD,QAAA,EAA1C,OAAM,gBAAe,GAAC,eAAa;AAAA;cAE3CA,YAMM,OAAA;AAAA,gBAND,OAAM;AAAA,gBAAe,MAAK;AAAA;gBAC7BA,YAEO,QAAA;AAAA,kBAFD,OAAM;AAAA,kBAAe,eAAY;AAAA;gCACrCC,YAAiP,OAAA;AAAA,oBAA5O,OAAM;AAAA,oBAAK,QAAO;AAAA,oBAAK,SAAQ;AAAA,oBAAY,MAAK;AAAA,oBAAO,QAAO;AAAA,oBAAe,gBAAa;AAAA,oBAAI,kBAAe;AAAA,oBAAQ,mBAAgB;AAAA;oBAAQD,YAA0D,QAAA,EAApD,GAAE,iDAAgD,CAAA;AAAA,oBAAEA,YAA+B,UAAA;AAAA,sBAAvB,IAAG;AAAA,sBAAK,IAAG;AAAA,sBAAK,GAAE;AAAA;;;gBAExOA,YAA2C,QAAA,EAArC,OAAM,gBAAe,GAAC,UAAQ;AAAA,gBACpCA,YAA+D,QAAA,EAAzD,OAAM,gBAAe,GAAC,8BAA4B;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":["_push","_parent","_createVNode","_createBlock","_ssrInterpolate","_openBlock","_Fragment","_renderList","_toDisplayString"],"sources":["../../../../../../../app/components/features/home/Banner.vue","../../../../../../../app/components/features/home/About.vue","../../../../../../../app/components/features/home/Projects.vue","../../../../../../../app/components/features/home/Experience.vue","../../../../../../../app/components/features/home/Skills.vue","../../../../../../../app/components/features/home/Contactus.vue"],"sourcesContent":["<script setup lang=\"ts\">\r\nimport { onBeforeUnmount, onMounted, ref } from 'vue';\r\n\r\nconst words = ['responsive', 'maintainable', 'accessible', 'production-ready'];\r\n\r\nconst rotatorText = ref(words[0]!);\r\nconst rotatorOut = ref(false);\r\n\r\nlet timer: ReturnType<typeof setInterval> | null = null;\r\nlet swapTimer: ReturnType<typeof setTimeout> | null = null;\r\n\r\nonMounted(() => {\r\n  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\r\n  let i = 0;\r\n  timer = setInterval(() => {\r\n    i = (i + 1) % words.length;\r\n    rotatorOut.value = true;\r\n    swapTimer = setTimeout(() => {\r\n      rotatorText.value = words[i]!;\r\n      rotatorOut.value = false;\r\n    }, 280);\r\n  }, 2400);\r\n});\r\n\r\nonBeforeUnmount(() => {\r\n  if (timer) clearInterval(timer);\r\n  if (swapTimer) clearTimeout(swapTimer);\r\n});\r\n</script>\r\n\r\n<template>\r\n  <section class=\"banner\" aria-labelledby=\"bnr-title\">\r\n    <div class=\"bnr_bg\" aria-hidden=\"true\">\r\n      <span class=\"orb orb1\"></span>\r\n      <span class=\"orb orb2\"></span>\r\n      <span class=\"orb orb3\"></span>\r\n    </div>\r\n    <UiWrapper>\r\n      <div class=\"bnr_con\">\r\n        <div class=\"bnr_info\">\r\n          <span class=\"status_pill\">\r\n            <span class=\"status_dot\" aria-hidden=\"true\"></span>\r\n            Available for new front-end work\r\n          </span>\r\n          <p class=\"eyebrow\">Front-End Developer · Cebu, PH</p>\r\n          <h1 id=\"bnr-title\">\r\n            Hi, I'm <span class=\"accent\">Chaimel</span>.<br>\r\n            I build clean, fast,<br>\r\n            <span class=\"rotator\">\r\n              <span class=\"rotator_word\" :class=\"{ 'is-out': rotatorOut }\" aria-hidden=\"true\">{{ rotatorText }}</span>\r\n            </span>\r\n            websites.\r\n          </h1>\r\n          <p class=\"bnr_copy\">\r\n            I build and maintain responsive websites with WordPress, Nuxt.js,\r\n            HTML, CSS, JavaScript, Bootstrap, PHP, and Android Java foundations.\r\n          </p>\r\n          <div class=\"bnr_actions\" aria-label=\"Primary actions\">\r\n            <a class=\"button button_primary\" href=\"mailto:chaimelenjambre15@gmail.com\">\r\n              <span>Email me</span>\r\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 5l7 7-7 7\"/></svg>\r\n            </a>\r\n            <a class=\"button button_secondary\" href=\"/Chaimel-Enjambre-Resume.pdf\" target=\"_blank\" rel=\"noopener\">View Résumé</a>\r\n          </div>\r\n          <dl class=\"bnr_stats\" aria-label=\"At a glance\">\r\n            <div>\r\n              <dt>Years building</dt>\r\n              <dd>5<span>+</span></dd>\r\n            </div>\r\n            <div>\r\n              <dt>Live sites shipped</dt>\r\n              <dd>6<span>+</span></dd>\r\n            </div>\r\n            <div>\r\n              <dt>Tools &amp; stacks</dt>\r\n              <dd>8<span>+</span></dd>\r\n            </div>\r\n          </dl>\r\n        </div>\r\n      </div>\r\n      <a class=\"scroll_indicator\" href=\"#projects\" aria-label=\"Scroll to projects\">\r\n        <span>Scroll</span>\r\n        <svg width=\"14\" height=\"22\" viewBox=\"0 0 14 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"1\" y=\"1\" width=\"12\" height=\"20\" rx=\"6\"/><line x1=\"7\" y1=\"6\" x2=\"7\" y2=\"10\"/></svg>\r\n      </a>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n","<script setup lang=\"ts\">\r\nconst points = [\r\n  { label: 'Build.', text: 'Custom WordPress themes and Nuxt.js front ends from design to live launch.' },\r\n  { label: 'Maintain.', text: 'Reliable updates, fixes, and content changes on production sites.' },\r\n  { label: 'Improve.', text: 'Faster loads, better responsiveness, cleaner code as the site grows.' },\r\n];\r\n</script>\r\n\r\n<template>\r\n  <section id=\"about\" class=\"about\" aria-label=\"Professional snapshot\">\r\n    <UiWrapper>\r\n      <div class=\"about_con\">\r\n        <div class=\"about_info\">\r\n          <p class=\"eyebrow\">Profile</p>\r\n          <h2>Web developer focused on clear delivery and maintainable front ends.</h2>\r\n        </div>\r\n        <div class=\"about_copy\">\r\n          <p>\r\n            My career goal is to keep growing as a full-stack web developer while\r\n            delivering project requirements on time and with quality. I am comfortable\r\n            working with clear direction, learning new tools, and turning designs and\r\n            website updates into dependable production work.\r\n          </p>\r\n          <ul class=\"about_boxes\" role=\"list\">\r\n            <li\r\n              v-for=\"(point, i) in points\"\r\n              :key=\"point.label\"\r\n              :class=\"['ab_box', `ab_box${i + 1}`, 'reveal']\"\r\n            >\r\n              <div class=\"ab_info\">\r\n                <strong>{{ point.label }}</strong> {{ point.text }}\r\n              </div>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n","<script setup lang=\"ts\">\r\ntype Project = {\r\n  title: string;\r\n  description: string;\r\n  href: string;\r\n  image: string;\r\n  alt: string;\r\n};\r\n\r\nconst projects: Project[] = [\r\n  {\r\n    title: 'Beulahland Christian Academy',\r\n    description: 'School site · WordPress build',\r\n    href: 'https://www.beulahlandjax.org/',\r\n    image: '/projects/p1.jpg',\r\n    alt: 'Beulahland Christian Academy website screenshot',\r\n  },\r\n  {\r\n    title: 'Spark City Smoke and Vape',\r\n    description: 'Retail site · WordPress build',\r\n    href: 'https://web.link2newsite.com/limelightll/sparkcityon575/',\r\n    image: '/projects/p2.jpg',\r\n    alt: 'Spark City Smoke and Vape website screenshot',\r\n  },\r\n  {\r\n    title: 'SMT Logistics',\r\n    description: 'Logistics site · WordPress build',\r\n    href: 'http://www.smtlg.com/',\r\n    image: '/projects/p3.jpg',\r\n    alt: 'SMT Logistics website screenshot',\r\n  },\r\n  {\r\n    title: 'SalmaStar Fishing Group',\r\n    description: 'Company site · WordPress build',\r\n    href: 'https://w3204.proweaversite3.com/',\r\n    image: '/projects/p4.jpg',\r\n    alt: 'SalmaStar Fishing Group website screenshot',\r\n  },\r\n  {\r\n    title: 'Summerfield Home Care',\r\n    description: 'Healthcare site · WordPress build',\r\n    href: 'https://www.summerfieldhomecare.com/',\r\n    image: '/projects/p5.jpg',\r\n    alt: 'Summerfield Home Care website screenshot',\r\n  },\r\n  {\r\n    title: 'Skyguide LLC',\r\n    description: 'Services site · WordPress build',\r\n    href: 'http://www.skyguidellc.com/',\r\n    image: '/projects/p6.jpg',\r\n    alt: 'Skyguide LLC website screenshot',\r\n  },\r\n];\r\n</script>\r\n\r\n<template>\r\n  <section id=\"projects\" class=\"projects\" aria-labelledby=\"project-title\">\r\n    <UiWrapper>\r\n      <div class=\"project_con\">\r\n        <div class=\"project_info\">\r\n          <p class=\"eyebrow\">Selected Work</p>\r\n          <h2 id=\"project-title\">Recent websites I have built and shipped.</h2>\r\n          <p class=\"section_sub\">A selection of WordPress and front-end work currently running in production.</p>\r\n        </div>\r\n        <div class=\"project_holder\">\r\n          <ul class=\"project_boxes\" role=\"list\">\r\n            <li\r\n              v-for=\"(project, i) in projects\"\r\n              :key=\"project.href\"\r\n              :class=\"['proj_box', `proj_box${i + 1}`, 'reveal']\"\r\n            >\r\n              <a :href=\"project.href\" target=\"_blank\" rel=\"noopener\">\r\n                <div class=\"proj_thumb\">\r\n                  <img :src=\"project.image\" :alt=\"project.alt\" loading=\"lazy\">\r\n                  <span class=\"proj_overlay\">\r\n                    <span class=\"proj_overlay_text\">Open site</span>\r\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M9 7h8v8\"/></svg>\r\n                  </span>\r\n                </div>\r\n                <div class=\"proj_info\">\r\n                  <div>\r\n                    <h3>{{ project.title }}</h3>\r\n                    <p class=\"proj_desc\">{{ project.description }}</p>\r\n                  </div>\r\n                  <span class=\"proj_tag\">Live</span>\r\n                </div>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n","<script setup lang=\"ts\">\r\ntype Role = {\r\n  date: string;\r\n  title: string;\r\n  org: string;\r\n  summary: string;\r\n};\r\n\r\nconst roles: Role[] = [\r\n  {\r\n    date: 'Oct 2022 — Present',\r\n    title: 'Front-End Developer',\r\n    org: 'Glophics',\r\n    summary: 'Maintains websites and handles updates using Nuxt.js.',\r\n  },\r\n  {\r\n    date: 'Feb 2021 — Sep 2022',\r\n    title: 'Front-End WordPress Developer',\r\n    org: 'Proweaver',\r\n    summary: 'Created custom WordPress websites using HTML, CSS, JavaScript, and theme workflows.',\r\n  },\r\n  {\r\n    date: 'Jun 2019 — Oct 2019',\r\n    title: 'App Tester',\r\n    org: 'Spingine Corporation',\r\n    summary: 'Tested applications, found bugs, and learned practical QA habits for software delivery.',\r\n  },\r\n  {\r\n    date: 'Jun 2018 — Feb 2019',\r\n    title: 'IT Trainee',\r\n    org: 'SystemsCore Inc.',\r\n    summary: 'Worked as an OJT software developer trainee in an IT and computer technology environment.',\r\n  },\r\n];\r\n</script>\r\n\r\n<template>\r\n  <section id=\"experience\" class=\"experience\" aria-labelledby=\"exp-title\">\r\n    <UiWrapper>\r\n      <div class=\"experience_con\">\r\n        <div class=\"experience_info\">\r\n          <p class=\"eyebrow\">Experience</p>\r\n          <h2 id=\"exp-title\">Front-end work across Nuxt.js, WordPress, and testing.</h2>\r\n        </div>\r\n        <ol class=\"exp_timeline\" role=\"list\">\r\n          <li\r\n            v-for=\"(role, i) in roles\"\r\n            :key=\"role.date\"\r\n            :class=\"['exp_box', `exp_box${i + 1}`, 'reveal']\"\r\n          >\r\n            <span class=\"exp_dot\" aria-hidden=\"true\"></span>\r\n            <p class=\"exp_date\">{{ role.date }}</p>\r\n            <h3>{{ role.title }}</h3>\r\n            <p class=\"exp_org\">{{ role.org }}</p>\r\n            <p>{{ role.summary }}</p>\r\n          </li>\r\n        </ol>\r\n      </div>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n","<script setup lang=\"ts\">\r\n</script>\r\n\r\n<template>\r\n  <section id=\"skills\" class=\"skills\" aria-labelledby=\"skills-title\">\r\n    <UiWrapper>\r\n      <div class=\"skills_con\">\r\n        <div class=\"skills_info\">\r\n          <p class=\"eyebrow\">Toolkit</p>\r\n          <h2 id=\"skills-title\">Practical tools for building, updating, and improving websites.</h2>\r\n        </div>\r\n        <ul class=\"skill_boxes\" role=\"list\">\r\n          <li class=\"skill_box skill_box1 reveal\">\r\n            <div class=\"skill_head\">\r\n              <span class=\"skill_icon\" aria-hidden=\"true\">\r\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\r\n              </span>\r\n              <h3>Front-End</h3>\r\n            </div>\r\n            <p>Markup, styling, and interactivity from page structure to ship-ready UI.</p>\r\n            <ul class=\"tech_list\">\r\n              <li>HTML</li>\r\n              <li>CSS</li>\r\n              <li>JavaScript</li>\r\n              <li>Nuxt.js</li>\r\n              <li>Bootstrap</li>\r\n              <li>Responsive&nbsp;design</li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"skill_box skill_box2 reveal\">\r\n            <div class=\"skill_head\">\r\n              <span class=\"skill_icon\" aria-hidden=\"true\">\r\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M3 5v14a9 3 0 0 0 18 0V5\"/><path d=\"M3 12a9 3 0 0 0 18 0\"/></svg>\r\n              </span>\r\n              <h3>CMS &amp; Back-End</h3>\r\n            </div>\r\n            <p>Building custom WordPress themes and working with server-side fundamentals.</p>\r\n            <ul class=\"tech_list\">\r\n              <li>WordPress</li>\r\n              <li>Theme&nbsp;dev</li>\r\n              <li>PHP</li>\r\n              <li>Android&nbsp;/&nbsp;Java</li>\r\n            </ul>\r\n          </li>\r\n          <li class=\"skill_box skill_box3 reveal\">\r\n            <div class=\"skill_head\">\r\n              <span class=\"skill_icon\" aria-hidden=\"true\">\r\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\r\n              </span>\r\n              <h3>Delivery</h3>\r\n            </div>\r\n            <p>Turning a brief into dependable, on-time output with clear communication.</p>\r\n            <ul class=\"tech_list\">\r\n              <li>Problem&nbsp;analysis</li>\r\n              <li>Self-direction</li>\r\n              <li>On-time&nbsp;delivery</li>\r\n              <li>Microsoft&nbsp;Office</li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n","<script setup lang=\"ts\">\r\n</script>\r\n\r\n<template>\r\n  <section id=\"contactus\" class=\"contactus\" aria-labelledby=\"contact-title\">\r\n    <UiWrapper>\r\n      <div class=\"contactus_con\">\r\n        <div class=\"contactus_info\">\r\n          <p class=\"eyebrow\">Contact</p>\r\n          <h2 id=\"contact-title\">Let us build something clear, responsive, and dependable.</h2>\r\n          <p class=\"contact_sub\">I'm open to front-end roles and freelance updates. Email is the fastest way to reach me — usually a reply within a day.</p>\r\n        </div>\r\n        <div class=\"contactus_actions\" aria-label=\"Contact details\">\r\n          <a class=\"contact_link\" href=\"mailto:chaimelenjambre15@gmail.com\">\r\n            <span class=\"contact_icon\" aria-hidden=\"true\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-10 6L2 7\"/></svg>\r\n            </span>\r\n            <span class=\"contact_label\">Email</span>\r\n            <span class=\"contact_value\">chaimelenjambre15@gmail.com</span>\r\n          </a>\r\n          <a class=\"contact_link\" href=\"tel:+639275372224\">\r\n            <span class=\"contact_icon\" aria-hidden=\"true\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z\"/></svg>\r\n            </span>\r\n            <span class=\"contact_label\">Phone</span>\r\n            <span class=\"contact_value\">0927 537 2224</span>\r\n          </a>\r\n          <div class=\"contact_link\" role=\"group\">\r\n            <span class=\"contact_icon\" aria-hidden=\"true\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\r\n            </span>\r\n            <span class=\"contact_label\">Location</span>\r\n            <span class=\"contact_value\">Ginatilan, Cebu, Philippines</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </UiWrapper>\r\n  </section>\r\n</template>\r\n"],"version":3}