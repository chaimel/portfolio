{
  // The tests run on Node's own type stripping (`npm test`), outside Nuxt's
  // tsconfigs. This gives the editor Node's types and the app's `~/` alias.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "~/*": ["../app/*"]
    }
  },
  "include": ["./**/*.ts"]
}
